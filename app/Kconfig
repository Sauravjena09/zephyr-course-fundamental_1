source "Kconfig.zephyr"
menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y

if LED_SUBSYSTEM

choice
    prompt "LED blink sleep time"
    default BLINK_1S

    config BLINK_250MS
        bool "250ms"

    config BLINK_500MS
        bool "500ms (fast)"

    config BLINK_1S
        bool "1s (medium)"

    config BLINK_2S
        bool "2s (slow)"
endchoice

config BLINK_SLEEP_TIME
    int
    default 250 if BLINK_250MS
    default 500 if BLINK_500MS
    default 1000 if BLINK_1S
    default 2000 if BLINK_2S

config BLINK_SLEEP_TIME_MS
    int
    default 250 if BLINK_250MS
    default 500 if BLINK_500MS
    default 1000 if BLINK_1S
    default 2000 if BLINK_2S

menuconfig ADVANCED_LED_SETTINGS
    bool "Advanced LED settings"

if ADVANCED_LED_SETTINGS

config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    range 0 100
    default 100

config LED_FADE_DURATION
    int "LED fade duration (ms)"
    range 0 5000
    default 500

menu "Expert settings"

config ENABLE_LED_DEBUGGING
    bool "Enable LED debugging"

config CUSTOM_BLINK_PATTERN
    bool "Custom blink pattern"

endmenu

endif
endif